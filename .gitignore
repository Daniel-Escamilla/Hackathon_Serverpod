# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock is committed on purpose: this is an application, four people
# on three operating systems need identical dependency versions, and the
# server Dockerfile does `COPY pubspec.lock .` and fails without it.

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Serverpod agent tooling (matches the Serverpod scaffold's own .gitignore):
# per-developer local config, regenerated by `serverpod create --ide claude`.
.dart_skills/
.claude/skills/
.mcp.json
.vscode/mcp.json

# --- Per-machine files that would break or overwrite the other three ---------
# Four people, three operating systems: anything below is personal, and
# committing it silently changes someone else's setup.

# Coding agents' personal settings (the workspace .gitignore covers its own
# folder; these cover the repo root). CLAUDE.md and AGENTS.md stay shared.
.claude/settings.local.json
CLAUDE.local.md
.cursor/
.codex/
.gemini/
.agents/

# Docker Compose loads an override file automatically. One committed with
# someone's personal port remaps would move everybody's ports.
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Editor settings hold absolute local paths (e.g. the Flutter SDK location).
# launch.json and tasks.json in hackathon_serverpod/.vscode stay shared.
.vscode/settings.json
.idea/
*.iml

# Flutter version managers point at a local SDK install.
.fvm/

# Operating system clutter.
.DS_Store
Thumbs.db
desktop.ini

*.log
