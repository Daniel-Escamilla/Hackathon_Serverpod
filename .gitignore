# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock is committed on purpose: this is an application, four people
# on three operating systems need identical dependency versions, and the
# server Dockerfile does `COPY pubspec.lock .` and fails without it.

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Serverpod agent tooling (matches the Serverpod scaffold's own .gitignore):
# per-developer local config, regenerated by `serverpod create --ide claude`.
.dart_skills/
.claude/skills/
.mcp.json
.vscode/mcp.json
