# Copy to .env and fill in real values, or just run scripts/run_on_phone.sh,
# which generates a .env with random dev secrets automatically if missing.
# These back the `server` service in docker-compose.yaml, which runs in the
# repurposed "staging" mode (config/staging.yaml). Never commit the real .env.
# Any random value works locally, e.g. `openssl rand -hex 24` for each.
SERVERPOD_SERVICE_SECRET=changeme
SERVERPOD_PASSWORD_emailSecretHashPepper=changeme
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=changeme
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=changeme
